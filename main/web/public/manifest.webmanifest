{
  "name": "Structorizer Web",
  "short_name": "Structorizer",
  "description": "Create, edit and execute Nassi-Shneiderman diagrams in the browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#e6e6e6",
  "theme_color": "#f0f0f0",
  "categories": ["education", "developer tools", "productivity"],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-structorizer": [".nsd"],
        "application/x-structorizer-arranger": [".arrz", ".arr"]
      }
    }
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
