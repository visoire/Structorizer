<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-35" preAlt="if" postAlt="" preCase="case" postCase="" preFor="for" postFor="to" stepFor="by" preForIn="foreach" postForIn="in" preWhile="while" postWhile="" preRepeat="until" postRepeat="" preLeave="leave" preReturn="return" preExit="exit" preThrow="throw" input="INPUT" output="OUTPUT" ignoreCase="true" origin="Structorizer Web 3.32.35-web.3" text="&#34;CoffeeProtocol&#34;" comment="&#34;Do not run before espresso.&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;caffeine &#60;- 0&#34;,&#34;bugs &#60;- 42&#34;,&#34;INPUT &#34;&#34;Friday? &#34;&#34;, friday&#34;" comment="&#34;The answer is always 42&#34;" color="ffff80" rotated="0" disabled="0"></instruction>
		<while text="&#34;while (caffeine &#60; 2)&#34;" comment="&#34;Minimum viable espresso&#34;" color="ffffff" disabled="0">
			<qWhile>
				<call text="&#34;brewEspresso()&#34;" comment="" color="80ffff" disabled="0" ismethoddecl="0"></call>
				<instruction text="&#34;caffeine &#60;- caffeine + 1&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
			</qWhile>
		</while>
		<case text="&#34;bugs&#34;,&#34;0&#34;,&#34;42&#34;,&#34;default&#34;" comment="" color="ffffff" branch_colors=",,," disabled="0">
			<qCase>
				<instruction text="&#34;OUTPUT &#34;&#34;Ship it!&#34;&#34;&#34;" comment="" color="80ff80" rotated="0" disabled="0"></instruction>
			</qCase>
			<qCase>
				<instruction text="&#34;OUTPUT &#34;&#34;Ask the duck.&#34;&#34;&#34;" comment="&#34;Rubber duck debugging&#34;" color="ffff80" rotated="0" disabled="0"></instruction>
			</qCase>
			<qCase>
				<alternative text="&#34;friday = true&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
					<qTrue>
						<jump text="&#34;throw &#34;&#34;No Friday deploys!&#34;&#34;&#34;" comment="" color="ff8080" disabled="0"></jump>
					</qTrue>
					<qFalse>
						<call text="&#34;fixBug(bugs)&#34;" comment="" color="ffffff" disabled="0" ismethoddecl="0"></call>
					</qFalse>
				</alternative>
			</qCase>
		</case>
		<try text="&#34;ex&#34;" comment="" color="ffffff" disabled="0">
			<qTry>
				<call text="&#34;pushToProd()&#34;" comment="" color="ffffff" disabled="0" ismethoddecl="0"></call>
			</qTry>
			<qCatch>
				<instruction text="&#34;OUTPUT &#34;&#34;Blame DNS: &#34;&#34;, ex&#34;" comment="&#34;It is always DNS&#34;" color="ff8080" rotated="0" disabled="0"></instruction>
			</qCatch>
			<qFinally color="ffffff">
			</qFinally>
		</try>
		<parallel text="&#34;2&#34;" comment="" color="ffffff" disabled="0">
			<qPara>
				<instruction text="&#34;OUTPUT &#34;&#34;Blame cache&#34;&#34;&#34;" comment="" color="80ff80" rotated="0" disabled="0"></instruction>
			</qPara>
			<qPara>
				<call text="&#34;updateResume()&#34;" comment="" color="80ffff" disabled="0" ismethoddecl="0"></call>
			</qPara>
		</parallel>
	</children>
</root>
